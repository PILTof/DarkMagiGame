# Скопируй в .env и измени значения:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)

# --- Клиентские переменные (доступны в браузере через import.meta.env) ---
# Обязательный префикс VITE_

VITE_UNIT_SPEED=4
VITE_DEBUG=true

# --- Только для vite.config.ts / Node (без префикса VITE_, в браузер НЕ попадают) ---
# PORT=4173
